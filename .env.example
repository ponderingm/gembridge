# アプリケーションポート
PORT=3000

# Node 環境
NODE_ENV=development

# 以下に環境変数を追加してください
# DATABASE_URL=
# API_KEY=

# Gembridge API ポート (外部公開)
# GEMINI_API_PORT=8005

# ブラウザ VNC ポート
# GEMINI_BROWSER_HTTP_PORT=3005
# GEMINI_BROWSER_HTTPS_PORT=3006

# Discord Webhook URL (完了通知用)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord Bot トークン (Discord Developer Portal で取得)
# DISCORD_BOT_TOKEN=

# タイムゾーン
# TZ=Asia/Tokyo
